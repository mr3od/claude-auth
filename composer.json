{
    "name": "mr3od/claude-auth",
    "description": "CLI tool to store and switch between multiple Claude Code account credentials, keeping settings/history/memory centralized.",
    "keywords": ["claude", "claude-code", "cli", "accounts", "auth"],
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Abdulrahman Alwan",
            "homepage": "https://github.com/mr3od"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel-zero/foundation": "^13.23",
        "laravel-zero/framework": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.30.4",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^4.7.8 || ^5.0.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "lint:fix": "pint",
        "test": "pest"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "bin": ["claude-auth"]
}
